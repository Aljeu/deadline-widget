{
  "name": "deadline-widget",
  "productName": "Deadline Widget",
  "version": "0.1.0",
  "private": true,
  "description": "Frameless desktop widget — macOS Mail academic deadlines, Digital Concrete aesthetic",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "start:dev": "concurrently -k \"vite\" \"electron . --dev\"",
    "pack": "npm run build && electron-builder --config electron-builder.yml",
    "pack:dir": "npm run build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8"
  }
}
